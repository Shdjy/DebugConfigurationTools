<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ImplicitUsings>false</ImplicitUsings>
    <AssemblyName>DebugConfigurationTool</AssemblyName>
    <AssemblyTitle>调试配置检查工具</AssemblyTitle>
    <Product>调试配置检查工具</Product>
    <Description>调试阶段配置检查与参数设置工具</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\PackagingInspectionTools.Core\Cpu\*.cs" Link="Core\Cpu\%(Filename)%(Extension)" />
    <Compile Include="..\PackagingInspectionTools.Core\Gpu\*.cs" Link="Core\Gpu\%(Filename)%(Extension)" />
    <Compile Include="..\PackagingInspectionTools.Core\Network\*.cs" Link="Core\Network\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

